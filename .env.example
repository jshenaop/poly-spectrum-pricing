# ============================================================
# GeoSight Platform - Variables de entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a Git.
# ============================================================

# Entorno de ejecucion: development | production | test
GEOSIGHT_ENV=development

# Ruta al directorio de datos GeoJSON
# En produccion usar ruta absoluta fuera del repo
GEOSIGHT_DATA_PATH=./app/data

# Nombre del archivo GeoJSON dentro de GEOSIGHT_DATA_PATH
# Solo el nombre del archivo, sin separadores de ruta
GEOSIGHT_GRID_DATA=n6_1k_aniop_ipm.geojson

# Puerto en que corre la aplicacion
GEOSIGHT_PORT=8000

# Nivel de log: DEBUG | INFO | WARNING | ERROR
GEOSIGHT_LOG_LEVEL=INFO

# Valor piso COP/MHz/Año — si el calculo es menor, se aplica este minimo
# 0 = sin piso
GEOSIGHT_VAL_MIN=201739

# Maximo de coordenadas permitidas en POST /assignments/multi
GEOSIGHT_MAX_POINTS=10

# Origenes CORS permitidos (separados por coma). Vacio = sin CORS externo.
# Ejemplo: http://localhost:3000,https://app.example.com
GEOSIGHT_CORS_ORIGINS=
