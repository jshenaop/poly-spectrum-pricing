# ============================================================
# GeoSight Platform - Variables de entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a Git.
# ============================================================

# Entorno de ejecucion: development | production | test
GEOSIGHT_ENV=development

# Ruta al directorio de datos GeoJSON
# En produccion usar ruta absoluta fuera del repo
GEOSIGHT_DATA_PATH=./app/data

# Puerto en que corre la aplicacion
GEOSIGHT_PORT=8000

# Nivel de log: DEBUG | INFO | WARNING | ERROR
GEOSIGHT_LOG_LEVEL=INFO

# Credenciales de acceso basico (cambiar en produccion)
GEOSIGHT_USER=admin
GEOSIGHT_PASSWORD=change_me_in_production

# Clave de API de Anthropic para integracion con Claude
ANTHROPIC_API_KEY=sk-ant-...
